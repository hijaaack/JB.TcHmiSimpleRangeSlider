<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>JB.TcHmiSimpleRangeSlider</id>
    <version>2.0.0</version>
    <description>Simple Range Slider</description>
    <authors>Jack Borelius</authors>
    <title>TcHmiSimpleRangeSlider</title>
    <owners>Jack Borelius</owners>
    <projectUrl>https://github.com/hijaaack/JB.TcHmiSimpleRangeSlider</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <releaseNotes>Updated framework to 14.3.154 and TypeScript to 5.3.2 and added a new event that triggers for every tick.</releaseNotes>
    <copyright>Copyright 2025</copyright>
    <tags>TwinCAT HMI</tags>
    <license type="expression">MIT</license>
    <icon>images/logo.png</icon>
    <dependencies>
      <group targetFramework="native1.12-tchmi">
        <dependency id="Beckhoff.TwinCAT.HMI.Framework" version="14.3.154" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="**\*" target="runtimes\native1.12-tchmi\" exclude=".eslintrc.json;**\*.nuspec;**\*.tpl.json;**\*.hmi*proj;**\~*;**\*.tmp;**\tmp*;**\*.user;**\tsconfig.json;**\*.log;**\*.bak;**\obj\**\*;packages.config;packages.xsd;.hmiframework\**\*;.hmipkgs\**\*;.git;.gitignore;.gitattributes" />
    <file src="images\logo.png" target="images\" />
  </files>
</package>